<!doctype html>
<html lang="en" class="{{#if_eq theme 'dark'}}dark{{/if_eq}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Tailwind CSS Play CDN — appropriate for standalone HTML reports that require no build step -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' }
    </script>
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@10.3.1/build/styles/atom-one-dark.min.css">

    <title>NPM Audit Report</title>
    <meta name="description" content="{{metadata.vulnerabilities.total}} known vulnerabilities found.">

    <style>
        pre { background-color: #282c34; padding: 1rem; border-radius: 0.375rem; overflow-x: auto; }
        pre code { color: #abb2bf; }
        dialog::backdrop { background: rgba(0, 0, 0, 0.5); }
    </style>
</head>

<body class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen pb-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl font-bold text-center py-8">NPM Audit Report</h1>

        <!-- Summary cards -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 text-center">
                <div class="text-2xl font-bold">{{numeral metadata.vulnerabilities.total "0,0"}}</div>
                <div class="text-gray-500 dark:text-gray-400 text-sm mt-1">Known vulnerabilities</div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 text-center">
                <div class="text-2xl font-bold">{{numeral metadata.dependencies.total "0,0"}}</div>
                <div class="text-gray-500 dark:text-gray-400 text-sm mt-1">Dependencies</div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 text-center">
                <div class="text-lg font-semibold">{{moment date "MMMM Do YYYY, h:mm:ss a"}}</div>
                <div class="text-gray-500 dark:text-gray-400 text-sm mt-1">Last updated</div>
            </div>
        </div>

        <!-- Severity breakdown cards -->
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-4 mb-6">
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 text-center">
                <div class="text-2xl font-bold">{{numeral metadata.vulnerabilities.critical "0,0"}}</div>
                <div class="mt-1">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold {{severityBadgeClass 'critical'}}">critical</span>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 text-center">
                <div class="text-2xl font-bold">{{numeral metadata.vulnerabilities.high "0,0"}}</div>
                <div class="mt-1">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold {{severityBadgeClass 'high'}}">high</span>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 text-center">
                <div class="text-2xl font-bold">{{numeral metadata.vulnerabilities.moderate "0,0"}}</div>
                <div class="mt-1">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold {{severityBadgeClass 'moderate'}}">moderate</span>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 text-center">
                <div class="text-2xl font-bold">{{numeral metadata.vulnerabilities.low "0,0"}}</div>
                <div class="mt-1">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold {{severityBadgeClass 'low'}}">low</span>
                </div>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 text-center">
                <div class="text-2xl font-bold">{{numeral metadata.vulnerabilities.info "0,0"}}</div>
                <div class="mt-1">
                    <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold {{severityBadgeClass 'info'}}">info</span>
                </div>
            </div>
        </div>

        <!-- Search -->
        <div class="mb-4">
            <input type="text" id="search" placeholder="Search vulnerabilities..."
                class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- Vulnerabilities table -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow overflow-x-auto">
            <table id="advisories" class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th scope="col" data-col="0"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider cursor-pointer select-none hover:bg-gray-100 dark:hover:bg-gray-600">
                            Name <span class="sort-icon ml-1 opacity-50">⇅</span>
                        </th>
                        <th scope="col" data-col="1"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider cursor-pointer select-none hover:bg-gray-100 dark:hover:bg-gray-600">
                            Module <span class="sort-icon ml-1 opacity-50">⇅</span>
                        </th>
                        <th scope="col" data-col="2"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider cursor-pointer select-none hover:bg-gray-100 dark:hover:bg-gray-600">
                            Severity <span class="sort-icon ml-1 opacity-50">⇅</span>
                        </th>
                        <th scope="col"
                            class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
                            CWEs
                        </th>
                    </tr>
                </thead>
                <tbody id="advisories-body" class="divide-y divide-gray-200 dark:divide-gray-700">
                    {{#each vulnerabilities}}
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700 cursor-pointer"
                        onclick="openModal('vuln-modal-{{safeDomId name}}')">
                        <td class="px-6 py-4 text-sm font-medium max-w-xs">
                            <a href="#" onclick="event.stopPropagation(); openModal('vuln-modal-{{safeDomId name}}')"
                                class="text-blue-600 dark:text-blue-400 hover:underline">{{_firstAdvisory.title}}</a>
                        </td>
                        <td class="px-6 py-4 text-sm whitespace-nowrap">
                            <a href="https://npmjs.com/package/{{name}}" target="_blank" rel="noopener"
                                onclick="event.stopPropagation()"
                                class="text-blue-600 dark:text-blue-400 hover:underline">{{name}}</a>
                        </td>
                        <td class="px-6 py-4 text-sm whitespace-nowrap"
                            data-severity-order="{{severityNumber severity}}">
                            <span
                                class="inline-block px-2 py-0.5 rounded text-xs font-semibold {{severityBadgeClass severity}}">{{severity}}</span>
                        </td>
                        <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-400">
                            {{#each _firstAdvisory.cwe}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Vulnerability modals -->
    {{#each vulnerabilities}}
    <dialog id="vuln-modal-{{safeDomId name}}"
        class="bg-white dark:bg-gray-800 dark:text-gray-100 rounded-lg shadow-xl max-w-3xl w-full mx-auto p-0 backdrop:bg-black/50">
        <div class="flex items-center justify-between p-4 border-b border-gray-200 dark:border-gray-700">
            <h5 class="text-base font-semibold flex items-center gap-2 pr-4">
                <span
                    class="inline-block px-2 py-0.5 rounded text-xs font-semibold shrink-0 {{severityBadgeClass severity}}">{{severity}}</span>
                {{_firstAdvisory.title}}
            </h5>
            <button onclick="closeModal('vuln-modal-{{safeDomId name}}')"
                class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 text-2xl leading-none shrink-0"
                aria-label="Close">&times;</button>
        </div>
        <div class="p-4 overflow-y-auto max-h-[70vh]">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4 text-sm">
                <ul class="space-y-1">
                    <li>Module: <a href="https://npmjs.com/package/{{name}}" target="_blank" rel="noopener"
                            class="text-blue-600 dark:text-blue-400 hover:underline">{{name}}</a></li>
                    {{#if _firstAdvisory.cwe}}
                    <li>{{#each _firstAdvisory.cwe}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</li>
                    {{/if}}
                </ul>
                <ul class="space-y-1">
                    {{#if range}}<li>Vulnerable: {{range}}</li>{{/if}}
                    {{#if fixAvailable}}<li>Fix: {{fixAvailableText fixAvailable}}</li>{{/if}}
                </ul>
            </div>

            {{#if _firstAdvisory.overview}}
            <h3 class="text-sm font-semibold mt-4 mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400">Overview</h3>
            <div class="text-sm">{{{markdown _firstAdvisory.overview}}}</div>
            {{/if}}

            <h3 class="text-sm font-semibold mt-4 mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400">Affected paths</h3>
            <div class="flex flex-wrap gap-1 mb-2">
                {{#each _paths}}
                <span class="font-mono text-xs bg-gray-100 dark:bg-gray-700 rounded px-2 py-0.5">{{this}}</span>
                {{/each}}
            </div>

            {{#if _firstAdvisory.recommendation}}
            <h3 class="text-sm font-semibold mt-4 mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400">Remediation</h3>
            <div class="text-sm">{{{markdown _firstAdvisory.recommendation}}}</div>
            {{/if}}

            {{#if _firstAdvisory.references}}
            <h3 class="text-sm font-semibold mt-4 mb-2 uppercase tracking-wide text-gray-500 dark:text-gray-400">References</h3>
            <div class="text-sm">{{{markdown _firstAdvisory.references}}}</div>
            {{/if}}

            {{#if isDirect}}
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-4">Direct dependency</p>
            {{/if}}
        </div>
        <div class="flex justify-end gap-2 p-4 border-t border-gray-200 dark:border-gray-700">
            {{#if _firstAdvisory.url}}
            <a href="{{_firstAdvisory.url}}" target="_blank" rel="noopener"
                class="px-4 py-2 bg-blue-600 text-white text-sm rounded hover:bg-blue-700">More about this
                vulnerability</a>
            {{/if}}
            <button onclick="closeModal('vuln-modal-{{safeDomId name}}')"
                class="px-4 py-2 bg-gray-200 dark:bg-gray-600 text-gray-800 dark:text-gray-100 text-sm rounded hover:bg-gray-300 dark:hover:bg-gray-500">Close</button>
        </div>
    </dialog>
    {{/each}}

    <script>
        function openModal(id) {
            document.getElementById(id).showModal();
        }

        function closeModal(id) {
            document.getElementById(id).close();
        }

        // Close on backdrop click
        document.querySelectorAll('dialog').forEach(function (dialog) {
            dialog.addEventListener('click', function (e) {
                var rect = dialog.getBoundingClientRect();
                if (e.clientX < rect.left || e.clientX > rect.right ||
                    e.clientY < rect.top || e.clientY > rect.bottom) {
                    dialog.close();
                }
            });
        });

        // Search
        document.getElementById('search').addEventListener('input', function () {
            var q = this.value.toLowerCase();
            document.querySelectorAll('#advisories-body tr').forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().indexOf(q) !== -1 ? '' : 'none';
            });
        });

        // Sort
        var sortCol = 2, sortDir = 1;

        document.querySelectorAll('#advisories thead th[data-col]').forEach(function (th) {
            th.addEventListener('click', function () {
                var col = parseInt(this.getAttribute('data-col'));
                if (sortCol === col) {
                    sortDir *= -1;
                } else {
                    sortCol = col;
                    sortDir = 1;
                }
                sortTable();
                document.querySelectorAll('#advisories thead .sort-icon').forEach(function (i) {
                    i.textContent = '⇅';
                    i.classList.add('opacity-50');
                });
                var icon = th.querySelector('.sort-icon');
                icon.textContent = sortDir === 1 ? '↑' : '↓';
                icon.classList.remove('opacity-50');
            });
        });

        function sortTable() {
            var tbody = document.getElementById('advisories-body');
            var rows = Array.prototype.slice.call(tbody.querySelectorAll('tr'));
            rows.sort(function (a, b) {
                var aVal, bVal;
                if (sortCol === 2) {
                    aVal = parseInt(a.querySelector('td[data-severity-order]').getAttribute('data-severity-order'));
                    bVal = parseInt(b.querySelector('td[data-severity-order]').getAttribute('data-severity-order'));
                } else {
                    var aTd = a.querySelectorAll('td')[sortCol];
                    var bTd = b.querySelectorAll('td')[sortCol];
                    aVal = aTd ? aTd.textContent.trim().toLowerCase() : '';
                    bVal = bTd ? bTd.textContent.trim().toLowerCase() : '';
                }
                if (aVal < bVal) return -sortDir;
                if (aVal > bVal) return sortDir;
                return 0;
            });
            rows.forEach(function (r) { tbody.appendChild(r); });
        }

        // Initial sort by severity
        sortTable();
    </script>
</body>

</html>
