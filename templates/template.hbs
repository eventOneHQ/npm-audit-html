<!doctype html>
<html lang="en" class="{{#if_eq theme 'dark'}}dark{{/if_eq}}">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = { darkMode: 'class' }
    </script>
    <link rel="stylesheet"
        href="https://cdn.jsdelivr.net/gh/highlightjs/cdn-release@11/build/styles/github-dark.min.css">
    <title>NPM Audit Report</title>

    <style>
        /* Severity-colored left border on table rows */
        .sev-critical  { border-left: 3px solid #dc2626; }
        .sev-high      { border-left: 3px solid #f97316; }
        .sev-moderate  { border-left: 3px solid #f59e0b; }
        .sev-low       { border-left: 3px solid #3b82f6; }
        .sev-info      { border-left: 3px solid #94a3b8; }

        /* Severity progress segments */
        .seg-critical  { background: #dc2626; }
        .seg-high      { background: #f97316; }
        .seg-moderate  { background: #f59e0b; }
        .seg-low       { background: #3b82f6; }
        .seg-info      { background: #94a3b8; }

        dialog {
            padding: 0;
            /* Center the dialog horizontally and vertically on all browsers */
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            margin: 0;
            /* Responsive width: near-full on mobile, capped on desktop */
            width: min(calc(100vw - 2rem), 42rem);
            max-height: min(90vh, 700px);
            overflow: hidden;
        }
        dialog::backdrop { background: rgba(0,0,0,0.55); backdrop-filter: blur(3px); }

        pre { background: #0d1117; padding: 1rem; border-radius: .5rem; overflow-x: auto; margin: .5rem 0; }
        pre code { font-family: 'JetBrains Mono', 'Fira Code', Consolas, monospace; font-size: .8rem; line-height: 1.6; }

        .filter-btn.active { outline: 2px solid currentColor; outline-offset: -2px; }

        /* Remove spinner on input[type=text] */
        input:focus { box-shadow: none; }
    </style>
</head>

<body class="bg-slate-100 dark:bg-slate-950 text-slate-900 dark:text-slate-100 min-h-screen antialiased">

    <!-- ── Header ───────────────────────────────────────────── -->
    <header class="bg-gradient-to-r from-slate-800 via-slate-800 to-slate-900 text-white shadow-lg">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
            <div class="flex items-center justify-between gap-4">
                <div class="flex items-center gap-3 min-w-0">
                    <!-- Shield icon -->
                    <div class="shrink-0 w-10 h-10 rounded-xl bg-red-500 shadow-md flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
                        </svg>
                    </div>
                    <div class="min-w-0">
                        <h1 class="text-lg font-bold tracking-tight leading-tight">NPM Audit Report</h1>
                        <p class="text-slate-400 text-xs truncate">Generated {{moment date "MMMM Do YYYY [at] h:mm a [UTC]"}}</p>
                    </div>
                </div>
                <!-- Dark / light toggle -->
                <button id="theme-toggle" onclick="toggleTheme()"
                    class="shrink-0 w-9 h-9 rounded-lg bg-white/10 hover:bg-white/20 transition-colors flex items-center justify-center"
                    title="Toggle dark / light mode">
                    <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>
                    </svg>
                    <svg id="icon-moon" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/>
                    </svg>
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">

        <!-- ── Summary row ──────────────────────────────────── -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Total vulnerabilities -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">Vulnerabilities</p>
                <p class="text-4xl font-extrabold leading-none mb-1">{{numeral metadata.vulnerabilities.total "0,0"}}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">known issues</p>
            </div>

            <!-- Total dependencies -->
            <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">Dependencies</p>
                <p class="text-4xl font-extrabold leading-none mb-1">{{numeral metadata.dependencies.total "0,0"}}</p>
                <p class="text-xs text-slate-500 dark:text-slate-400">packages scanned</p>
            </div>

            <!-- Severity breakdown — spans 2 cols on large screens -->
            <div class="col-span-2 bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 p-5">
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-3">Severity breakdown</p>

                <!-- Stacked progress bar -->
                <div class="flex rounded-full overflow-hidden h-2 mb-4 bg-slate-100 dark:bg-slate-700" id="severity-bar">
                    {{#if metadata.vulnerabilities.critical}}<div class="seg-critical" style="flex:{{metadata.vulnerabilities.critical}}" title="Critical: {{metadata.vulnerabilities.critical}}"></div>{{/if}}
                    {{#if metadata.vulnerabilities.high}}<div class="seg-high" style="flex:{{metadata.vulnerabilities.high}}" title="High: {{metadata.vulnerabilities.high}}"></div>{{/if}}
                    {{#if metadata.vulnerabilities.moderate}}<div class="seg-moderate" style="flex:{{metadata.vulnerabilities.moderate}}" title="Moderate: {{metadata.vulnerabilities.moderate}}"></div>{{/if}}
                    {{#if metadata.vulnerabilities.low}}<div class="seg-low" style="flex:{{metadata.vulnerabilities.low}}" title="Low: {{metadata.vulnerabilities.low}}"></div>{{/if}}
                    {{#if metadata.vulnerabilities.info}}<div class="seg-info" style="flex:{{metadata.vulnerabilities.info}}" title="Info: {{metadata.vulnerabilities.info}}"></div>{{/if}}
                </div>

                <div class="grid grid-cols-5 gap-2 text-center">
                    <div>
                        <p class="text-base font-bold text-red-600 dark:text-red-400">{{numeral metadata.vulnerabilities.critical "0,0"}}</p>
                        <p class="text-xs text-slate-500 mt-0.5">Critical</p>
                    </div>
                    <div>
                        <p class="text-base font-bold text-orange-500 dark:text-orange-400">{{numeral metadata.vulnerabilities.high "0,0"}}</p>
                        <p class="text-xs text-slate-500 mt-0.5">High</p>
                    </div>
                    <div>
                        <p class="text-base font-bold text-amber-500 dark:text-amber-400">{{numeral metadata.vulnerabilities.moderate "0,0"}}</p>
                        <p class="text-xs text-slate-500 mt-0.5">Moderate</p>
                    </div>
                    <div>
                        <p class="text-base font-bold text-blue-500 dark:text-blue-400">{{numeral metadata.vulnerabilities.low "0,0"}}</p>
                        <p class="text-xs text-slate-500 mt-0.5">Low</p>
                    </div>
                    <div>
                        <p class="text-base font-bold text-slate-400">{{numeral metadata.vulnerabilities.info "0,0"}}</p>
                        <p class="text-xs text-slate-500 mt-0.5">Info</p>
                    </div>
                </div>
            </div>
        </div>

        {{#if metadata.vulnerabilities.total}}

        <!-- ── Filter / search bar ──────────────────────────── -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 px-4 py-3 flex flex-col sm:flex-row gap-3 items-start sm:items-center">
            <!-- Search input -->
            <div class="relative flex-1 w-full">
                <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                </svg>
                <input id="search" type="text" placeholder="Search vulnerabilities…" autocomplete="off"
                    class="w-full pl-9 pr-4 py-2 text-sm rounded-xl border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
            </div>
            <!-- Severity filter pills -->
            <div class="flex flex-wrap gap-1.5 shrink-0">
                <button class="filter-btn active" data-filter="all">All</button>
                <button class="filter-btn" data-filter="critical" data-color="red">Critical</button>
                <button class="filter-btn" data-filter="high" data-color="orange">High</button>
                <button class="filter-btn" data-filter="moderate" data-color="amber">Moderate</button>
                <button class="filter-btn" data-filter="low" data-color="blue">Low</button>
                <button class="filter-btn" data-filter="info" data-color="slate">Info</button>
            </div>
        </div>

        <!-- ── Vulnerability table ───────────────────────────── -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full">
                    <thead>
                        <tr class="border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/60 text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                            <th class="w-px pl-4 pr-0 py-3"></th>
                            <th data-col="name" class="sortable px-4 py-3 text-left cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 select-none">
                                Advisory <span class="sort-icon ml-0.5 opacity-40">⇅</span>
                            </th>
                            <th data-col="module" class="sortable px-4 py-3 text-left cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 select-none">
                                Package <span class="sort-icon ml-0.5 opacity-40">⇅</span>
                            </th>
                            <th data-col="severity" class="sortable px-4 py-3 text-left cursor-pointer hover:text-slate-700 dark:hover:text-slate-200 select-none">
                                Severity <span class="sort-icon ml-0.5 opacity-40">⇅</span>
                            </th>
                            <th class="px-4 py-3 text-left hidden sm:table-cell">CWE</th>
                            <th class="px-4 py-3 text-left hidden md:table-cell">Fix</th>
                            <th class="px-4 py-3 text-left hidden lg:table-cell">Paths</th>
                            <th class="w-8 pr-4"></th>
                        </tr>
                    </thead>
                    <tbody id="vuln-body" class="divide-y divide-slate-100 dark:divide-slate-700/50">
                        {{#each vulnerabilities}}
                        <tr class="sev-{{severity}} hover:bg-blue-50/40 dark:hover:bg-slate-700/40 cursor-pointer transition-colors group"
                            data-severity="{{severity}}"
                            data-severity-order="{{severityNumber severity}}"
                            onclick="openModal('vuln-modal-{{safeDomId name}}')">

                            <!-- Severity dot -->
                            <td class="pl-4 pr-0 py-4">
                                <span class="inline-block w-2 h-2 rounded-full {{severityBadgeClass severity}}"></span>
                            </td>

                            <!-- Advisory title + URL -->
                            <td class="px-4 py-4" data-sort="{{_firstAdvisory.title}}">
                                {{#if _isTransitive}}
                                <div class="font-medium text-sm text-slate-600 dark:text-slate-300 leading-snug max-w-xs">
                                    {{name}}
                                </div>
                                <div class="text-xs text-slate-400 mt-0.5 max-w-xs truncate">via: {{#if via}}{{#each via}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}{{/if}}</div>
                                {{else}}
                                <div class="font-medium text-sm text-blue-700 dark:text-blue-400 group-hover:underline leading-snug max-w-xs truncate">
                                    {{_firstAdvisory.title}}
                                </div>
                                {{#if _firstAdvisory.url}}
                                <div class="text-xs text-slate-400 truncate max-w-xs mt-0.5">{{_firstAdvisory.url}}</div>
                                {{/if}}
                                {{/if}}
                            </td>

                            <!-- Package name + vulnerable range -->
                            <td class="px-4 py-4 whitespace-nowrap" data-sort="{{name}}">
                                <a href="https://npmjs.com/package/{{name}}" target="_blank" rel="noopener"
                                    onclick="event.stopPropagation()"
                                    class="font-mono text-sm font-semibold text-slate-800 dark:text-slate-100 hover:text-blue-600 dark:hover:text-blue-400 hover:underline transition-colors">{{name}}</a>
                                {{#if range}}
                                <div class="font-mono text-xs text-slate-400 mt-0.5">{{range}}</div>
                                {{/if}}
                            </td>

                            <!-- Severity badge -->
                            <td class="px-4 py-4 whitespace-nowrap" data-sort="{{severityNumber severity}}">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold {{severityBadgeClass severity}}">
                                    {{severity}}
                                </span>
                            </td>

                            <!-- CWE -->
                            <td class="px-4 py-4 text-xs text-slate-500 dark:text-slate-400 font-mono hidden sm:table-cell">
                                {{#each _firstAdvisory.cwe}}{{this}}{{#unless @last}}<br>{{/unless}}{{/each}}
                            </td>

                            <!-- Fix available -->
                            <td class="px-4 py-4 text-xs hidden md:table-cell">
                                {{#if fixAvailable}}
                                <span class="inline-flex items-center gap-1 font-medium text-emerald-700 dark:text-emerald-400">
                                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                                    </svg>
                                    {{fixAvailableText fixAvailable}}
                                </span>
                                {{else}}
                                <span class="text-slate-300 dark:text-slate-600">—</span>
                                {{/if}}
                            </td>

                            <!-- First path + remainder count -->
                            <td class="px-4 py-4 hidden lg:table-cell">
                                {{#if _paths}}
                                <code class="text-xs bg-slate-100 dark:bg-slate-700/60 text-slate-700 dark:text-slate-300 rounded px-1.5 py-0.5">{{_paths.[0]}}</code>
                                {{#if _pathsRemainder}}
                                <span class="text-xs text-slate-400 ml-1">+{{_pathsRemainder}} more</span>
                                {{/if}}
                                {{/if}}
                            </td>

                            <!-- Chevron -->
                            <td class="pr-4 py-4 text-right">
                                <svg class="w-4 h-4 text-slate-300 dark:text-slate-600 opacity-0 group-hover:opacity-100 transition-opacity inline-block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/>
                                </svg>
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>

            <!-- No-results empty state (shown via JS) -->
            <div id="no-results" class="hidden text-center py-14 text-slate-400 dark:text-slate-500">
                <svg class="w-10 h-10 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 15.803 7.5 7.5 0 0016.803 15.803z"/>
                </svg>
                <p class="text-sm">No vulnerabilities match your search or filter.</p>
            </div>
        </div>

        {{else}}

        <!-- ── Clean bill of health ──────────────────────────── -->
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-sm border border-slate-200 dark:border-slate-700 text-center py-20">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-100 dark:bg-emerald-900/30 mb-4">
                <svg class="w-8 h-8 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>
                </svg>
            </div>
            <h2 class="text-lg font-bold text-emerald-700 dark:text-emerald-400 mb-1">No vulnerabilities found</h2>
            <p class="text-sm text-slate-500 dark:text-slate-400">All {{numeral metadata.dependencies.total "0,0"}} dependencies are clean.</p>
        </div>

        {{/if}}

        <!-- Footer -->
        <p class="text-center text-xs text-slate-400 dark:text-slate-600 pb-2">
            Generated by <a href="https://github.com/eventOneHQ/npm-audit-html" target="_blank" rel="noopener" class="hover:underline">npm-audit-html</a>
        </p>

    </main>

    <!-- ── Vulnerability modals ──────────────────────────────── -->
    {{#each vulnerabilities}}
    <dialog id="vuln-modal-{{safeDomId name}}"
        class="bg-white dark:bg-slate-800 text-slate-900 dark:text-slate-100 rounded-2xl shadow-2xl overflow-hidden border border-slate-200 dark:border-slate-700">

        <!-- Severity color stripe -->
        <div class="h-1 {{severityBadgeClass severity}}"></div>

        <!-- Modal header -->
        <div class="flex items-start gap-4 px-6 py-5 border-b border-slate-200 dark:border-slate-700">
            <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1.5">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold {{severityBadgeClass severity}}">{{severity}}</span>
                    {{#if isDirect}}<span class="text-xs text-slate-500 dark:text-slate-400 border border-slate-300 dark:border-slate-600 rounded-full px-2 py-0.5 font-medium">direct</span>{{/if}}
                    {{#if _isTransitive}}<span class="text-xs text-slate-500 dark:text-slate-400 border border-slate-300 dark:border-slate-600 rounded-full px-2 py-0.5 font-medium">transitive</span>{{/if}}
                </div>
                <h2 class="text-base font-bold leading-snug">{{name}}</h2>
                {{#if _isTransitive}}
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                    Affected through:
                    {{#if via}}{{#each via}}<code class="font-mono text-xs bg-slate-100 dark:bg-slate-700 rounded px-1">{{this}}</code>{{#unless @last}}, {{/unless}}{{/each}}{{/if}}
                </p>
                {{else}}
                <p class="text-sm text-slate-600 dark:text-slate-300 mt-0.5 leading-snug">{{_firstAdvisory.title}}</p>
                {{/if}}
                <a href="https://npmjs.com/package/{{name}}" target="_blank" rel="noopener"
                    class="font-mono text-xs text-blue-600 dark:text-blue-400 hover:underline mt-0.5 inline-block">{{name}}</a>
            </div>
            <button onclick="closeModal('vuln-modal-{{safeDomId name}}')"
                class="shrink-0 w-8 h-8 flex items-center justify-center rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-700 transition-colors"
                aria-label="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- Modal body: 130px accounts for the header (badge+title+padding) + severity stripe height -->
        <div class="overflow-y-auto px-6 py-5 space-y-6" style="max-height: calc(min(90vh, 700px) - 130px)">

            <!-- Metadata grid -->
            <div class="grid grid-cols-2 gap-x-6 gap-y-4 text-sm">
                {{#if _firstAdvisory.cwe}}
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-1">CWE</p>
                    <p class="font-mono">{{#each _firstAdvisory.cwe}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
                </div>
                {{/if}}
                {{#if range}}
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-1">Vulnerable range</p>
                    <p class="font-mono">{{range}}</p>
                </div>
                {{/if}}
                {{#if fixAvailable}}
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-1">Fix</p>
                    <p class="text-emerald-700 dark:text-emerald-400 font-semibold flex items-center gap-1">
                        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                        </svg>
                        {{fixAvailableText fixAvailable}}
                    </p>
                </div>
                {{/if}}
                {{#if _firstAdvisory.url}}
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-1">Advisory</p>
                    <a href="{{_firstAdvisory.url}}" target="_blank" rel="noopener"
                        class="text-blue-600 dark:text-blue-400 hover:underline text-xs break-all">{{_firstAdvisory.url}}</a>
                </div>
                {{/if}}
            </div>

            <!-- Overview -->
            {{#if _firstAdvisory.overview}}
            <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">Overview</p>
                <div class="text-sm leading-relaxed prose-like">{{{markdown _firstAdvisory.overview}}}</div>
            </div>
            {{/if}}

            <!-- Affected paths -->
            {{#if _paths}}
            <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">
                    Affected paths <span class="font-normal normal-case tracking-normal">({{_paths.length}})</span>
                </p>
                <div class="bg-slate-50 dark:bg-slate-900/50 rounded-xl border border-slate-200 dark:border-slate-700 p-3 space-y-1 max-h-40 overflow-y-auto">
                    {{#each _paths}}
                    <p class="font-mono text-xs text-slate-700 dark:text-slate-300">{{this}}</p>
                    {{/each}}
                </div>
            </div>
            {{/if}}

            <!-- Remediation -->
            {{#if _firstAdvisory.recommendation}}
            <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">Remediation</p>
                <div class="text-sm leading-relaxed prose-like">{{{markdown _firstAdvisory.recommendation}}}</div>
            </div>
            {{/if}}

            <!-- References -->
            {{#if _firstAdvisory.references}}
            <div>
                <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 dark:text-slate-500 mb-2">References</p>
                <div class="text-sm leading-relaxed prose-like">{{{markdown _firstAdvisory.references}}}</div>
            </div>
            {{/if}}

        </div>

        <!-- Modal footer -->
        <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50">
            {{#if _firstAdvisory.url}}
            <a href="{{_firstAdvisory.url}}" target="_blank" rel="noopener"
                class="inline-flex items-center gap-1.5 px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold rounded-xl transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/>
                </svg>
                View advisory
            </a>
            {{/if}}
            <button onclick="closeModal('vuln-modal-{{safeDomId name}}')"
                class="px-4 py-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 text-sm font-semibold rounded-xl transition-colors">
                Close
            </button>
        </div>
    </dialog>
    {{/each}}

    <script>
        // ── Theme toggle ─────────────────────────────────────────────
        function toggleTheme () {
            document.documentElement.classList.toggle('dark')
            updateThemeIcons()
        }
        function updateThemeIcons () {
            var dark = document.documentElement.classList.contains('dark')
            document.getElementById('icon-sun').classList.toggle('hidden', !dark)
            document.getElementById('icon-moon').classList.toggle('hidden', dark)
        }
        updateThemeIcons()

        // ── Filter button styles (applied via JS so Tailwind CDN can scan them) ──
        ;(function styleBtns () {
            var palette = {
                all:      'bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-600',
                critical: 'bg-red-50 dark:bg-red-950/60 text-red-700 dark:text-red-400 hover:bg-red-100 dark:hover:bg-red-900/60',
                high:     'bg-orange-50 dark:bg-orange-950/60 text-orange-700 dark:text-orange-400 hover:bg-orange-100 dark:hover:bg-orange-900/60',
                moderate: 'bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 hover:bg-amber-100 dark:hover:bg-amber-900/60',
                low:      'bg-blue-50 dark:bg-blue-950/60 text-blue-700 dark:text-blue-400 hover:bg-blue-100 dark:hover:bg-blue-900/60',
                info:     'bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-700'
            }
            document.querySelectorAll('.filter-btn').forEach(function (btn) {
                var key = btn.getAttribute('data-filter') || 'all'
                btn.className = 'filter-btn px-3 py-1.5 rounded-xl text-xs font-semibold transition-colors ' + (palette[key] || palette.all)
            })
        })()

        // ── Modal ─────────────────────────────────────────────────────
        function openModal (id) { document.getElementById(id).showModal() }
        function closeModal (id) { document.getElementById(id).close() }

        document.querySelectorAll('dialog').forEach(function (d) {
            d.addEventListener('click', function (e) {
                var r = d.getBoundingClientRect()
                if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) d.close()
            })
        })

        // ── Filter + Search ───────────────────────────────────────────
        var currentFilter = 'all'
        var currentSearch = ''

        function applyFilters () {
            var rows = document.querySelectorAll('#vuln-body tr')
            var visible = 0
            rows.forEach(function (row) {
                var matchSev  = currentFilter === 'all' || row.getAttribute('data-severity') === currentFilter
                var matchText = !currentSearch || row.textContent.toLowerCase().indexOf(currentSearch) !== -1
                var show = matchSev && matchText
                row.style.display = show ? '' : 'none'
                if (show) visible++
            })
            var noResults = document.getElementById('no-results')
            if (noResults) noResults.classList.toggle('hidden', visible > 0)
        }

        var searchInput = document.getElementById('search')
        if (searchInput) {
            searchInput.addEventListener('input', function () {
                currentSearch = this.value.toLowerCase()
                applyFilters()
            })
        }

        document.querySelectorAll('.filter-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                document.querySelectorAll('.filter-btn').forEach(function (b) { b.classList.remove('active') })
                btn.classList.add('active')
                currentFilter = btn.getAttribute('data-filter')
                applyFilters()
            })
        })

        // ── Sort ──────────────────────────────────────────────────────
        var sortCol = 'severity'
        var sortDir = 1

        function getCellValue (row, col) {
            if (col === 'severity') return parseInt(row.getAttribute('data-severity-order'), 10) || 99
            var tds = row.querySelectorAll('td')
            var td = col === 'name' ? tds[1] : tds[2]
            if (!td) return ''
            return (td.getAttribute('data-sort') || td.textContent).trim().toLowerCase()
        }

        function sortTable () {
            var tbody = document.getElementById('vuln-body')
            if (!tbody) return
            var rows = Array.from(tbody.querySelectorAll('tr'))
            rows.sort(function (a, b) {
                var av = getCellValue(a, sortCol)
                var bv = getCellValue(b, sortCol)
                if (av < bv) return -sortDir
                if (av > bv) return sortDir
                return 0
            })
            rows.forEach(function (r) { tbody.appendChild(r) })
        }

        document.querySelectorAll('th.sortable').forEach(function (th) {
            th.addEventListener('click', function () {
                var col = this.getAttribute('data-col')
                sortDir = sortCol === col ? sortDir * -1 : 1
                sortCol = col
                document.querySelectorAll('th.sortable .sort-icon').forEach(function (i) {
                    i.textContent = '⇅'
                    i.style.opacity = '0.4'
                })
                var icon = th.querySelector('.sort-icon')
                icon.textContent = sortDir === 1 ? '↑' : '↓'
                icon.style.opacity = '1'
                sortTable()
            })
        })

        sortTable()
    </script>
</body>

</html>
